# Copy to .env.local (gitignored) and fill in real values for local dev.
# On your deploy platform (Vercel/Netlify/etc.), set these as environment variables.

# EmailJS lead forms
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# CRM lead intake. Set both only after the CRM migration/endpoint is deployed.
# With either value missing, the lead form safely continues using EmailJS.
VITE_CRM_LEAD_ENDPOINT=https://api.dezignpool.com/api/public/website-leads
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key

# Meta Pixel is loaded only after the visitor accepts analytics cookies.
VITE_META_PIXEL_ID=your_meta_pixel_id
